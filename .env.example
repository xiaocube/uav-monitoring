# =====================================================
# SkyGuard Environment Variables (Example)
# Copy to .env and fill in real values. NEVER commit .env
# =====================================================

# Runtime
SKYGUARD_ENV=development            # development | staging | production
SKYGUARD_LOG_LEVEL=INFO
SKYGUARD_CONFIG_DIR=./config
SKYGUARD_DATA_DIR=./data
SKYGUARD_MODEL_DIR=./models
SKYGUARD_LOG_DIR=./logs

# Compute
SKYGUARD_DEVICE=auto               # auto | cpu | cuda | mps
SKYGUARD_NUM_WORKERS=4

# Telemetry (later sprints)
SKYGUARD_API_HOST=0.0.0.0
SKYGUARD_API_PORT=8000

# Database (later sprints)
SKYGUARD_DB_URL=postgresql://skyguard:skyguard@localhost:5432/skyguard
